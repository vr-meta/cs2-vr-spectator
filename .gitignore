# CMake's build tree for tests/. Generated by `cmake -S tests -B build/tests`, which is
# what CI runs and what anyone reproducing the unit tests runs; none of it belongs in the
# history.
/build/

# What the experiment scripts leave behind.
*.tga
*.log

# Headset recordings pulled off the Quest. Hundreds of megabytes each, and they are
# captures of the operator's own sessions - never the repository's business.
recordings/
