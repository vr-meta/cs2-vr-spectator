diff --git a/AfxHookSource2/RenderSystemDX11Hooks.cpp b/AfxHookSource2/RenderSystemDX11Hooks.cpp
index 73b7c00..d3ea691 100644
--- a/AfxHookSource2/RenderSystemDX11Hooks.cpp
+++ b/AfxHookSource2/RenderSystemDX11Hooks.cpp
@@ -8,6 +8,8 @@
 #include "WrpConsole.h"
 #include "CamIO.h"
 #include "MirvFix.h"
+#include "MirvVr.h"
+#include "MirvVrXr.h"
 
 #include "RenderCommands.h"
 #include "StreamSettings.h"
@@ -60,6 +62,11 @@ extern void ExecuteClientCmd(const char * value);
 
 int g_iRenderContextDebug = 0;
 
+// cs2-vr-spectator: which render pass is being set up. 0 is the main pass, 1..N the extra
+// (mirv_streams) passes. Written on the engine thread only, from the pass loop below.
+int g_AfxVrFrameIndex = 0;
+int g_AfxVrPassIndex = 0;
+
 CRenderCommands g_RenderCommands;
 
 bool g_bEnableReShade = true;
@@ -2986,6 +2993,13 @@ public:
     void EngineThread_Prepare() {
         m_RecordingExtraPassesIterator = m_RecordingExtraPasses.begin();
 
+        // cs2-vr-spectator: VR is a second source of extra passes, independent of
+        // recording. Without this the eyes would only render while mirv_streams is
+        // writing ~300 MB/s of TGA to disk.
+        MirvVrXr_EngineThread_Frame();
+        m_VrPassesDone = 0;
+        m_VrPassesWanted = MirvVrXr_WantsPasses() ? 2 : 0;
+
         if (m_Recording) {
             if (m_AutoForceFullReSmoke) {
                 if (!m_Restore_smoke_volume_lod_ratio_change) {
@@ -3012,10 +3026,36 @@ public:
     }
 
     bool EngineThread_HasNextRenderPass() {
-        return m_RecordingExtraPassesIterator != m_RecordingExtraPasses.end();
+        return m_RecordingExtraPassesIterator != m_RecordingExtraPasses.end()
+            || m_VrPassesDone < m_VrPassesWanted;
     }
 
     void EngineThread_BeginNextRenderPass() {
+        g_AfxVrPassIndex++; // cs2-vr-spectator
+        if(g_AfxVrFrameIndex < g_AfxVrLogUntilFrame) {
+            advancedfx::Message("AFXVR: frame=%i BeginNextRenderPass -> pass=%i\n", g_AfxVrFrameIndex, g_AfxVrPassIndex);
+        }
+        AfxVr_OnBeginRenderPass(g_AfxVrPassIndex);
+
+        // cs2-vr-spectator: passes 1 and 2 are the eyes. Their finished back buffer
+        // arrives at BeforePresent, on the render thread, which is where it is copied
+        // into the OpenXR swapchain.
+        //
+        // The count is advanced HERE rather than in EndNextRenderPass, which is what the
+        // recording path does. Advancing at the end means HasNextRenderPass is still true
+        // when the last eye has been begun but not yet ended, so the loop starts one more
+        // pass that renders the whole scene and throws it away - a quarter of the frame's
+        // work. The final pass is still ended properly, by the scene system hook.
+        if (m_VrPassesDone < m_VrPassesWanted) {
+            int eyeIndex = m_VrPassesDone;
+            m_VrPassesDone++;
+            auto & pRenderPassCommands = g_RenderCommands.EngineThread_GetCommands();
+            pRenderPassCommands.BeforePresent.Push(
+                [eyeIndex](ID3D11DeviceContext * pDeviceContext, ID3D11Texture2D * pTexture) {
+                    MirvVrXr_RenderThread_SubmitEye(eyeIndex, pDeviceContext, pTexture);
+                });
+        }
+
         auto it = m_RecordingExtraPassesIterator;
         while(it != m_RecordingExtraPasses.end()) {
             it->EngineThread_BeginFrame();
@@ -3041,6 +3081,13 @@ public:
     }    
 
     void EngineThread_BeginMainRenderPass() {
+        g_AfxVrFrameIndex++; // cs2-vr-spectator
+        g_AfxVrPassIndex = 0;
+        if(g_AfxVrFrameIndex < g_AfxVrLogUntilFrame) {
+            advancedfx::Message("AFXVR: frame=%i BeginMainRenderPass\n", g_AfxVrFrameIndex);
+        }
+        AfxVr_OnBeginRenderPass(g_AfxVrPassIndex);
+
         for(auto it = m_RecordingMainPass.begin(); it != m_RecordingMainPass.end(); it++) {
             it->EngineThread_BeginFrame();
         }
@@ -3563,6 +3610,10 @@ private:
     std::multiset<CStream,RenderPassCompare> m_RecordingExtraPasses;
     std::multiset<CStream,RenderPassCompare>::iterator m_RecordingExtraPassesIterator;
 
+    // cs2-vr-spectator: extra passes owned by the VR session rather than by recording.
+    int m_VrPassesWanted = 0;
+    int m_VrPassesDone = 0;
+
     std::map<std::string, CStreamSettings> m_Streams;
 
     bool m_Shutdown = false;
