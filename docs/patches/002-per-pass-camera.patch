@@ -649,6 +758,17 @@ bool CS2_Client_CSetupView_Trampoline_IsPlayingDemo(void *ThisCViewSetup) {
 	float *pViewOrigin = (float*)((unsigned char *)ThisCViewSetup + 0x4a0);
