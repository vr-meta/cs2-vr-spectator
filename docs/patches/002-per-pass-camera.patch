+		g_AfxVrBaseOrigin[0] = Tx; g_AfxVrBaseOrigin[1] = Ty; g_AfxVrBaseOrigin[2] = Tz;
+		g_AfxVrBaseAngles[0] = Rx; g_AfxVrBaseAngles[1] = Ry; g_AfxVrBaseAngles[2] = Rz;
+		g_AfxVrBaseFov = Fov;
+
+		if (g_AfxVrFrameIndex < g_AfxVrLogUntilFrame) {
+			advancedfx::Message(
+				"AFXVR: frame=%i pass=%i SetupView this=%p t=%f org=(%f,%f,%f) ang=(%f,%f,%f) fov=%f eye=%f res=%ix%i\n",
+				g_AfxVrFrameIndex, g_AfxVrPassIndex, ThisCViewSetup, curTime,
+				Tx, Ty, Tz, Rx, Ry, Rz, Fov, eyeOffset, width, height);
+		}
+	}
+
 	if (g_S2CamIO.GetCamExport())
 	{
 		CamIO::CamData camData;
@@ -978,6 +1125,15 @@ void __fastcall New_CViewRender_UnkMakeMatrix(void* This) {
 	g_WorldToScreenMatrix.m[3][2] = proj[4*3+2];
 	g_WorldToScreenMatrix.m[3][3] = proj[4*3+3];
 
