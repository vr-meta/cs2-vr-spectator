diff --git a/AfxHookSource2/main.cpp b/AfxHookSource2/main.cpp
index efbea01..2c845d5 100644
--- a/AfxHookSource2/main.cpp
+++ b/AfxHookSource2/main.cpp
@@ -634,6 +634,115 @@ extern bool g_b_on_c_view_render_setup_view;
 
 extern bool MirvFovOverride(float &fov);
 
+// cs2-vr-spectator ////////////////////////////////////////////////////////////
+//
+// Probe for phase B: is this trampoline called once per frame, or once per
+// render pass? g_AfxVrFrameIndex / g_AfxVrPassIndex are maintained by the pass
+// loop in RenderSystemDX11Hooks.cpp.
+
+extern int g_AfxVrFrameIndex;
+extern int g_AfxVrPassIndex;
+
+int g_AfxVrLogUntilFrame = 0; // log while g_AfxVrFrameIndex < this; also read by the pass loop
+static float g_AfxVrEyeSeparation = 0.0f; // units (1 unit = 1 inch); 0 disables
+
+// Last CViewSetup seen by the trampoline, and the camera it settled on. The pass loop
+// writes an eye offset back into it - see AfxVr_OnBeginRenderPass below. Whether that
+// has any effect is exactly what is being measured: if the object is a stack temporary
+// or is not re-read per pass, the image will not move.
+static void * g_AfxVrViewSetup = nullptr;
+static float g_AfxVrBaseOrigin[3] = {0.0f, 0.0f, 0.0f};
+static float g_AfxVrBaseAngles[3] = {0.0f, 0.0f, 0.0f};
+static bool g_AfxVrDirty = false; // an eye offset is currently sitting in the CViewSetup
+static float g_AfxVrBaseFov = 90.0f;
+static float g_AfxVrFovDelta = 0.0f; // added to pass 2's fov; a per-eye projection probe
+
+// Offset of a given pass along the view's right vector, in units.
+// Pass 0 (the main pass) is never offset: it is what the player sees.
+static float AfxVr_PassEyeOffset(int passIndex) {
+	if (0.0f == g_AfxVrEyeSeparation) return 0.0f;
+	switch (passIndex) {
+	case 1: return -0.5f * g_AfxVrEyeSeparation; // left eye
+	case 2: return +0.5f * g_AfxVrEyeSeparation; // right eye
+	default: return 0.0f;
+	}
+}
+
+// Source angles are (pitch, yaw, roll) in degrees; this is AngleVectors' right.
+static void AfxVr_RightVector(float pitch, float yaw, float roll, float outRight[3]) {
+	const double deg2rad = M_PI / 180.0;
+	double sp = sin(pitch * deg2rad), cp = cos(pitch * deg2rad);
+	double sy = sin(yaw * deg2rad), cy = cos(yaw * deg2rad);
+	double sr = sin(roll * deg2rad), cr = cos(roll * deg2rad);
+
+	outRight[0] = (float)(-sr * sp * cy + cr * sy);
+	outRight[1] = (float)(-sr * sp * sy - cr * cy);
+	outRight[2] = (float)(-sr * cp);
+}
+
+// Called from the render pass loop, once per extra pass, before that pass renders.
+void AfxVr_OnBeginRenderPass(int passIndex) {
+	if (nullptr == g_AfxVrViewSetup) return;
+
+	// Phase D probe: does changing the fov between passes reach the projection? If the
+	// projection is rebuilt inside OnClientOutput from this struct - which is what the
+	// camera result implies - then per-eye fov costs nothing beyond this.
+	if (0.0f != g_AfxVrFovDelta) {
+		float * pFov = (float*)((unsigned char *)g_AfxVrViewSetup + 0x498);
+		*pFov = (2 == passIndex) ? g_AfxVrBaseFov + g_AfxVrFovDelta : g_AfxVrBaseFov;
+		g_AfxVrDirty = true;
+	}
+
+	if (0.0f == g_AfxVrEyeSeparation) return;
+
+	// A zero offset still writes, so the main pass gets the base camera back rather
+	// than whatever the previous frame's last eye left behind.
+	float eyeOffset = AfxVr_PassEyeOffset(passIndex);
+
+	float right[3];
+	AfxVr_RightVector(g_AfxVrBaseAngles[0], g_AfxVrBaseAngles[1], g_AfxVrBaseAngles[2], right);
+
+	float * pViewOrigin = (float*)((unsigned char *)g_AfxVrViewSetup + 0x4a0);
+	pViewOrigin[0] = g_AfxVrBaseOrigin[0] + eyeOffset * right[0];
+	pViewOrigin[1] = g_AfxVrBaseOrigin[1] + eyeOffset * right[1];
+	pViewOrigin[2] = g_AfxVrBaseOrigin[2] + eyeOffset * right[2];
+	g_AfxVrDirty = 0.0f != eyeOffset;
+
+	if (g_AfxVrFrameIndex < g_AfxVrLogUntilFrame) {
+		advancedfx::Message("AFXVR: frame=%i pass=%i wrote org=(%f,%f,%f) into %p\n",
+			g_AfxVrFrameIndex, passIndex,
+			pViewOrigin[0], pViewOrigin[1], pViewOrigin[2], g_AfxVrViewSetup);
+	}
+}
+
+CON_COMMAND(mirv_vr_fovtest, "cs2-vr-spectator: add this many degrees to the right eye's fov (0 = off).") {
+	if (2 <= args->ArgC()) {
+		g_AfxVrFovDelta = (float)atof(args->ArgV(1));
+	}
+	advancedfx::Message(
+		"mirv_vr_fovtest <degrees> - probes whether the projection is rebuilt per pass.\n"
+		"Current value: %f\n",
+		g_AfxVrFovDelta);
+}
+
+CON_COMMAND(mirv_vr_log, "cs2-vr-spectator: log view setup calls for N frames.") {
+	int frames = 2 <= args->ArgC() ? atoi(args->ArgV(1)) : 1;
+	g_AfxVrLogUntilFrame = g_AfxVrFrameIndex + frames;
+	advancedfx::Message("mirv_vr_log: logging frames %i..%i\n", g_AfxVrFrameIndex, g_AfxVrLogUntilFrame - 1);
+}
+
+CON_COMMAND(mirv_vr_eyes, "cs2-vr-spectator: eye separation in units for extra render passes (0 = off).") {
+	if (2 <= args->ArgC()) {
+		g_AfxVrEyeSeparation = (float)atof(args->ArgV(1));
+	}
+	advancedfx::Message(
+		"mirv_vr_eyes <units> - pass 1 is shifted left, pass 2 right, by half this.\n"
+		"Current value: %f\n",
+		g_AfxVrEyeSeparation);
+}
+
