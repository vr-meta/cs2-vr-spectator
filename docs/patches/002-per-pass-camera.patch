+# cs2-vr-spectator: OpenXR headers. The loader is opened by explicit path at runtime
+# rather than linked, so only the include directory is needed here.
+if(NOT DEFINED AFXVR_OPENXR_DIR AND DEFINED ENV{AFXVR_OPENXR_DIR})
+    set(AFXVR_OPENXR_DIR_DEFAULT "$ENV{AFXVR_OPENXR_DIR}")
+else()
+    set(AFXVR_OPENXR_DIR_DEFAULT "D:/Dev/cs2-vr-tools/openxr/pkg")
+endif()
+set(AFXVR_OPENXR_DIR "${AFXVR_OPENXR_DIR_DEFAULT}" CACHE PATH "OpenXR SDK root (headers under include/)")
+if(NOT EXISTS "${AFXVR_OPENXR_DIR}/include/openxr/openxr.h")
+    message(FATAL_ERROR "cs2-vr-spectator: OpenXR headers not found at ${AFXVR_OPENXR_DIR}/include/openxr/openxr.h -- pass -DAFXVR_OPENXR_DIR=<sdk root>, or set the AFXVR_OPENXR_DIR environment variable. See cs2-vr-spectator/docs/install.md.")
+endif()
+target_include_directories(${PROJECT_NAME} PRIVATE "${AFXVR_OPENXR_DIR}/include")
+
 #set_target_properties(
 #    ${PROJECT_NAME}
 #    PROPERTIES 
