+			"AFXVR: frame=%i pass=%i MakeMatrix this=%p proj[0][0]=%f proj[1][1]=%f\n",
+			g_AfxVrFrameIndex, g_AfxVrPassIndex, This, p[0], p[5]);
+	}
+
 	g_CampathDrawer.OnEngineThread_SetupViewDone();
